{
  "name": "agent-payment-splitter",
  "version": "1.1.0",
  "description": "Automatic payment splitting for collaborative agent tasks — escrow, weighted splits with deterministic dust handling, dispute workflow, and hash-chained audit journal",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aps": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "demo": "bun examples/demo.ts",
    "demo:write": "bun examples/demo.ts > examples/demo-output.txt",
    "start": "bun src/server.ts"
  },
  "keywords": [
    "agents",
    "payments",
    "escrow",
    "split",
    "reconciliation",
    "multi-agent",
    "ledger",
    "audit"
  ],
  "author": "Retsumdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/agent-payment-splitter.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/agent-payment-splitter/issues"
  },
  "homepage": "https://github.com/Retsumdk/agent-payment-splitter#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "bun-types": "^1.1.34",
    "typescript": "^5.7.2"
  }
}
